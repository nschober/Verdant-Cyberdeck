[Unit]
Description=TFT Terminal and Pwnagotchi chooser
After=systemd-udev-settle.service tft-console.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do grep -qi ili9488 /proc/fb && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /opt/tft-terminal/launcher.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
